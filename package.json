{
	"name": "world-war-3",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "bun@1.4.2",
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"check": "svelte-kit sync && bun run i18n:compile && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && bun run i18n:compile && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "bun run i18n:compile && vitest run",
		"test:watch": "bun run i18n:compile && vitest"
	},
	"devDependencies": {
		"@eslint/compat": "2.1.1",
		"@eslint/js": "10.0.1",
		"@iconify-json/circle-flags": "1.2.12",
		"@iconify-json/fluent": "1.2.59",
		"@iconify-json/fluent-emoji": "1.2.7",
		"@iconify-json/lucide": "1.2.140",
		"@inlang/paraglide-js": "2.26.0",
		"@sveltejs/adapter-vercel": "7.0.0",
		"@sveltejs/kit": "3.0.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.6.4",
		"daisyui": "5.7.47",
		"eslint": "10.12.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "17.13.0",
		"planck": "1.5.0",
		"prettier": "3.9.9",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.1",
		"unplugin-icons": "24.0.0",
		"vite": "8.3.3",
		"vitest": "5.0.3"
	}
}
