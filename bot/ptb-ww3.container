[Unit]
Description="ptb-ww3"
After=local-fs.target

[Container]
# No custom image: the runner is plain Bun, dependencies are installed from package.json at start.
Image=docker.io/oven/bun:1
AutoUpdate=registry
ContainerName=ptb-ww3

LogDriver=journald
WorkingDir=/app
# data/ww3.db (the purchase ledger) and config.local.json live in this bind mount, so they survive restarts and redeploys.
Volume=%h/projects/ptb-ww3:/app:Z

EnvironmentFile=%h/projects/ptb-ww3/.env
Environment=CONTAINER=true

Exec=sh -c "bun install --production && bun scripts/build.mjs --no-app && bun runner/main.js"

[Service]
Restart=always

[Install]
WantedBy=default.target
