{
  "$schema": "./node_modules/@tgcloud/cli/schema/tgcloud.json",
  // The game (ww3-sv, static export) plus the legal pages, assembled by `npm run build`
  "static": {
    "source": "app",
    // Every page is a client-rendered shell, so index.html can render any route
    "spa": true,
    "immutable": ["/_app/immutable/*"],
    "headers": [
      // The service worker and the version file must never be cached, or players miss updates
      { "path": "/service-worker.js", "set": { "Cache-Control": "no-cache" } },
      { "path": "/_app/version.json", "set": { "Cache-Control": "no-cache" } }
    ]
  }
}
