{
	"name": "world-war-3",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "bun@1.4.2",
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"check": "svelte-kit sync && bun run i18n:compile && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && bun run i18n:compile && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "bun run i18n:compile && vitest run",
		"test:watch": "bun run i18n:compile && vitest"
	},
	"devDependencies": {
		"@eslint/compat": "2.1.1",
		"@eslint/js": "9.39.2",
		"@iconify-json/circle-flags": "1.2.10",
		"@iconify-json/fluent": "1.2.36",
		"@iconify-json/fluent-emoji": "1.2.7",
		"@iconify-json/lucide": "1.2.83",
		"@inlang/paraglide-js": "2.7.2",
		"@sveltejs/adapter-vercel": "6.3.0",
		"@sveltejs/kit": "2.49.3",
		"@sveltejs/vite-plugin-svelte": "6.2.3",
		"@tailwindcss/vite": "4.1.18",
		"@types/node": "24.19.0",
		"daisyui": "5.5.14",
		"eslint": "9.39.2",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.14.0",
		"globals": "17.0.0",
		"prettier": "3.7.4",
		"prettier-plugin-svelte": "3.4.1",
		"prettier-plugin-tailwindcss": "0.7.2",
		"svelte": "5.46.1",
		"svelte-check": "4.7.6",
		"tailwindcss": "4.1.18",
		"typescript": "5.9.3",
		"typescript-eslint": "8.52.0",
		"unplugin-icons": "22.5.0",
		"vite": "7.3.1",
		"vitest": "4.1.11"
	}
}
